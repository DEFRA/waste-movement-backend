{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Producer (Municipal)",
  "description": "Producer fields specific to municipal waste. organisationName, address and contactDetails are required; sicCode is optional. Exactly one of authorisationNumber or reasonForNoAuthorisationNumber must be provided.",
  "examples": [
    {
      "wasteSource": "MUNICIPAL",
      "organisationName": "Test Council",
      "reasonForNoAuthorisationNumber": "TBC",
      "address": {
        "fullAddress": "Council Depot, Test City",
        "postcode": "TE1 5CD"
      },
      "contactDetails": {
        "emailAddress": "waste.services@example.gov.uk",
        "phoneNumber": "01234567890"
      }
    }
  ],
  "type": "object",
  "allOf": [
    { "$ref": "producer-base.schema.json" },
    {
      "type": "object",
      "if": {
        "properties": { "authorisationNumber": {} },
        "required": ["authorisationNumber"]
      },
      "then": {
        "properties": {
          "reasonForNoAuthorisationNumber": {
            "not": {},
            "description": "Not allowed when 'authorisationNumber' is provided"
          }
        }
      },
      "else": {
        "properties": { "reasonForNoAuthorisationNumber": {} },
        "required": ["reasonForNoAuthorisationNumber"],
        "description": "Required when 'authorisationNumber' is not provided"
      },
      "properties": {
        "wasteSource": {
          "const": "MUNICIPAL",
          "description": "Waste originates from a municipal source."
        },
        "organisationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Producer organisation name."
        },
        "authorisationNumber": {
          "$ref": "../authorisation-number.schema.json",
          "description": "Producer environmental permit or exemption number, in a valid UK format. Exactly one of 'authorisationNumber' or 'reasonForNoAuthorisationNumber' is required."
        },
        "reasonForNoAuthorisationNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "Reason no authorisationNumber is held. Free text for now — enum values TBC pending BA/policy input. Exactly one of 'authorisationNumber' or 'reasonForNoAuthorisationNumber' is required."
        },
        "sicCode": {
          "type": "string",
          "pattern": "^\\d{5}$",
          "description": "Five-digit Standard Industrial Classification code."
        },
        "contactDetails": {
          "$ref": "../contact-details.schema.json",
          "description": "How to contact the producer."
        },
        "address": {
          "$ref": "../address.schema.json",
          "description": "The producer's address."
        }
      },
      "required": [
        "wasteSource",
        "organisationName",
        "address",
        "contactDetails"
      ]
    }
  ],
  "propertyNames": {
    "enum": [
      "wasteSource",
      "organisationName",
      "authorisationNumber",
      "reasonForNoAuthorisationNumber",
      "sicCode",
      "contactDetails",
      "address"
    ]
  }
}
