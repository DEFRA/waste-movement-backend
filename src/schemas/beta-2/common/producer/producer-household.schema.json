{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beta-2/common/producer/producer-household.schema.json",
  "title": "Producer (Household)",
  "description": "Producer fields specific to household waste. organisationName, authorisationNumber, sicCode, emailAddress, phoneNumber and address do not apply and must not be provided.",
  "type": "object",
  "allOf": [
    { "$ref": "producer-base.schema.json" },
    {
      "type": "object",
      "properties": {
        "wasteSource": {
          "const": "Household",
          "description": "Waste originates from a household."
        }
      },
      "required": ["wasteSource"]
    }
  ],
  "propertyNames": {
    "enum": ["wasteSource", "councilMovement"]
  }
}
