{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Waste item",
  "description": "A single item of waste in a movement. classification and physicalDetails are required; treatments is optional.",
  "examples": [
    {
      "classification": {
        "wasteDescription": "Mixed municipal waste",
        "ewcCodes": ["200301"],
        "pops": {
          "isPresent": false
        },
        "hazardous": {
          "isPresent": false
        }
      },
      "physicalDetails": {
        "form": "SOLID",
        "containerType": "DRU",
        "containerCount": 4,
        "totalWeight": {
          "amount": 250.5,
          "unit": "KILOGRAMS",
          "isEstimate": false
        }
      },
      "treatments": [
        {
          "disposalOrRecoveryCode": "R3",
          "weight": {
            "amount": 250.5,
            "unit": "KILOGRAMS",
            "isEstimate": false
          }
        }
      ]
    },
    {
      "classification": {
        "wasteDescription": "Soil and stones containing hazardous substances",
        "ewcCodes": ["170503"],
        "pops": {
          "isPresent": false
        },
        "hazardous": {
          "isPresent": true,
          "codes": ["HP_14"],
          "componentsSource": "GUIDANCE",
          "componentsNotApplicable": true
        }
      },
      "physicalDetails": {
        "form": "MIXED",
        "containerType": "LOO",
        "containerCount": 0,
        "totalWeight": {
          "amount": 2,
          "unit": "TONNES",
          "isEstimate": true
        }
      }
    }
  ],
  "type": "object",
  "properties": {
    "classification": {
      "$ref": "classification.schema.json",
      "description": "What the waste item is: its description, EWC codes, POPs and hazardous properties."
    },
    "physicalDetails": {
      "$ref": "physical-details.schema.json",
      "description": "The physical form, containers and total weight of the waste item."
    },
    "treatments": {
      "$ref": "treatments.schema.json",
      "description": "The disposal or recovery operations applied to this waste item. Optional; when provided, at least one is required."
    }
  },
  "required": ["classification", "physicalDetails"],
  "additionalProperties": false
}
