{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Record collection response",
  "description": "Response returned when a Collection is recorded.",
  "type": "object",
  "required": ["data", "validation"],
  "properties": {
    "data": {
      "type": "object",
      "description": "The Collection that was recorded.",
      "required": ["collectionId"],
      "properties": {
        "collectionId": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the recorded Collection.",
          "examples": ["3f2b8c1e-6d4a-4f7e-9b2c-8a1d5e7f0c9b"]
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "$ref": "../common/validation.schema.json",
      "description": "Data-quality feedback on the request."
    }
  },
  "additionalProperties": false
}
