{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Waste Tracking API",
    "version": "beta-2",
    "description": "Milestone `beta-2` of the waste-movement journey — creation, collection, delivery and receipt, with data validation. Payload fields are being added a resource at a time; each request schema shows what its endpoint carries so far."
  },
  "servers": [
    {
      "url": "https://waste-tracking.integration.api.defra.gov.uk/beta-2",
      "description": "Integration / ext-test (public)"
    }
  ],
  "security": [
    {
      "bearerAuth": [],
      "apiCode": []
    }
  ],
  "tags": [
    {
      "name": "Movement",
      "description": "Create and manage Movements."
    },
    {
      "name": "Collection",
      "description": "Record a Collection — waste passing from a producer to a driver."
    },
    {
      "name": "Delivery",
      "description": "Record a Delivery, generating one or more Delivery IDs."
    },
    {
      "name": "Receipt",
      "description": "Record receipt of waste at a receiver site."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "AWS Cognito access token, obtained with the OAuth 2.0 client credentials grant (`POST {authBaseUrl}/oauth2/token` with your client ID and secret). Sent as `Authorization: Bearer <token>`."
      },
      "apiCode": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-code",
        "description": "The `apiCode` issued to your organisation, identifying who the submission is made on behalf of. Sent as a header rather than in the request body."
      }
    },
    "parameters": {
      "movementIdPath": {
        "name": "movementId",
        "in": "path",
        "required": true,
        "description": "Movement ID minted by `POST /movements`.",
        "schema": {
          "$ref": "#/components/schemas/movementId"
        },
        "example": "25HRA0B2"
      },
      "deliveryIdPath": {
        "name": "deliveryId",
        "in": "path",
        "required": true,
        "description": "Delivery ID returned by `POST /deliveries`.",
        "schema": {
          "$ref": "#/components/schemas/deliveryId"
        },
        "example": "25KMT4Z9"
      }
    },
    "headers": {
      "RequestId": {
        "description": "Trace id for this request. Quote it to support if something goes wrong.",
        "required": true,
        "schema": {
          "type": "string",
          "example": "4c6f9e1a-8f2b-4e3d-9a1c-2b7d5e6f0a3c"
        }
      }
    },
    "schemas": {
      "movementId": {
        "$ref": "./common/movement-id.schema.json"
      },
      "deliveryId": {
        "$ref": "./common/delivery-id.schema.json"
      },
      "createMovementRequest": {
        "$ref": "./creation/create-movement-request.schema.json"
      },
      "recordCollectionRequest": {
        "$ref": "./collection/record-collection-request.schema.json"
      },
      "recordDeliveryRequest": {
        "$ref": "./delivery/record-delivery-request.schema.json"
      },
      "recordReceiptRequest": {
        "$ref": "./receipt/record-receipt-request.schema.json"
      },
      "recordReceiptUndocumentedRequest": {
        "$ref": "./receipt/record-receipt-undocumented-request.schema.json"
      },
      "issue": {
        "$ref": "./common/issue.schema.json"
      },
      "problemDetails": {
        "type": "object",
        "description": "RFC 9457 Problem Details (`application/problem+json`).",
        "required": ["type", "title", "detail", "instance", "requestId"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Stable URI identifying the problem kind.",
            "example": "https://defra.github.io/digital-waste-tracking-api-site/preview/problems/bad-request"
          },
          "title": {
            "type": "string",
            "description": "Short, stable summary for this problem type.",
            "example": "Request validation failed"
          },
          "detail": {
            "type": "string",
            "description": "Human-readable detail specific to this occurrence.",
            "example": "The request could not be stored because 1 field is invalid."
          },
          "instance": {
            "type": "string",
            "description": "The request path where the problem occurred.",
            "example": "/movements"
          },
          "requestId": {
            "type": "string",
            "description": "Trace id for this request, matching the `x-request-id` header."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/issue"
            },
            "description": "Field-level problems. Present on 400 responses; omitted otherwise."
          }
        },
        "additionalProperties": false
      },
      "createMovementResponse": {
        "$ref": "./creation/create-movement-response.schema.json"
      },
      "recordCollectionResponse": {
        "$ref": "./collection/record-collection-response.schema.json"
      },
      "recordDeliveryResponse": {
        "$ref": "./delivery/record-delivery-response.schema.json"
      },
      "recordReceiptResponse": {
        "$ref": "./receipt/record-receipt-response.schema.json"
      },
      "recordReceiptUndocumentedResponse": {
        "$ref": "./receipt/record-receipt-undocumented-response.schema.json"
      }
    },
    "responses": {
      "400": {
        "description": "The request could not be stored (validation, format or state error).",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/problemDetails"
            }
          }
        }
      },
      "401": {
        "description": "Missing or invalid authentication.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/problemDetails"
            }
          }
        }
      },
      "500": {
        "description": "Unexpected server error.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/problemDetails"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/movements": {
      "post": {
        "tags": ["Movement"],
        "summary": "Create a Movement",
        "description": "Creates a new Movement and returns its Movement ID.",
        "operationId": "createMovement",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createMovementRequest"
              },
              "examples": {
                "commercial": {
                  "$ref": "./creation/create-movement-request.examples.json#/commercial"
                },
                "household": {
                  "$ref": "./creation/create-movement-request.examples.json#/household"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Movement created. Body carries the new Movement ID and any validation warnings.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/createMovementResponse"
                },
                "examples": {
                  "commercial": {
                    "$ref": "./creation/create-movement-response.examples.json#/commercial"
                  },
                  "household": {
                    "$ref": "./creation/create-movement-response.examples.json#/household"
                  }
                }
              }
            },
            "links": {
              "RecordCollection": {
                "operationId": "recordCollection",
                "description": "The returned `movementId` identifies the Movement whose Collection is recorded.",
                "parameters": {
                  "movementId": "$response.body#/data/movementId"
                }
              },
              "RecordDelivery": {
                "operationId": "recordDelivery",
                "description": "The returned `movementId` can be included in the `movementIds` of a Delivery.",
                "requestBody": {
                  "movementIds": ["$response.body#/data/movementId"]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/movements/{movementId}/collection": {
      "parameters": [
        {
          "$ref": "#/components/parameters/movementIdPath"
        }
      ],
      "post": {
        "tags": ["Collection"],
        "summary": "Record the Collection for a Movement",
        "description": "Records the Collection for the given Movement.",
        "operationId": "recordCollection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/recordCollectionRequest"
              },
              "examples": {
                "withBrokerAndReferences": {
                  "$ref": "./collection/record-collection-request.examples.json#/withBrokerAndReferences"
                },
                "minimal": {
                  "$ref": "./collection/record-collection-request.examples.json#/minimal"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Collection recorded. Body carries any validation warnings.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/recordCollectionResponse"
                },
                "examples": {
                  "withBrokerAndReferences": {
                    "$ref": "./collection/record-collection-response.examples.json#/withBrokerAndReferences"
                  },
                  "minimal": {
                    "$ref": "./collection/record-collection-response.examples.json#/minimal"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "description": "Movement not found.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problemDetails"
                },
                "example": {
                  "type": "https://defra.github.io/digital-waste-tracking-api-site/preview/problems/not-found",
                  "title": "Not Found",
                  "detail": "movementId not found",
                  "instance": "/movements/25HRA0B2/collection",
                  "requestId": "4c6f9e1a-8f2b-4e3d-9a1c-2b7d5e6f0a3c"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/deliveries": {
      "post": {
        "tags": ["Delivery"],
        "summary": "Record a Delivery",
        "description": "Records a Delivery. All the non-hazardous Movements share one new Delivery ID; each hazardous Movement gets its own Delivery, whose Delivery ID is its Movement ID.",
        "operationId": "recordDelivery",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/recordDeliveryRequest"
              },
              "examples": {
                "twoMovements": {
                  "$ref": "./delivery/record-delivery-request.examples.json#/twoMovements"
                },
                "mixedWasteTypes": {
                  "$ref": "./delivery/record-delivery-request.examples.json#/mixedWasteTypes"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Delivery recorded. Body carries the recorded Deliveries — the non-hazardous one first, then one per hazardous Movement in the order submitted — and any validation warnings.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/recordDeliveryResponse"
                },
                "examples": {
                  "twoMovements": {
                    "$ref": "./delivery/record-delivery-response.examples.json#/twoMovements"
                  },
                  "mixedWasteTypes": {
                    "$ref": "./delivery/record-delivery-response.examples.json#/mixedWasteTypes"
                  }
                }
              }
            },
            "links": {
              "RecordReceipt": {
                "operationId": "recordReceipt",
                "description": "Each returned `deliveryId` identifies a Delivery whose Receipt is recorded.",
                "parameters": {
                  "deliveryId": "$response.body#/data/deliveries/0/deliveryId"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/receipts": {
      "post": {
        "tags": ["Receipt"],
        "summary": "Record receipt of undocumented waste",
        "description": "Fallback for recording receipt with no prior Delivery, e.g. waste received with no movement trail. Not linked to any Movement; `reasonForNoDeliveryId` must explain why. The server creates an empty Delivery behind the scenes and returns its `deliveryId`, so the Receipt stays addressable.",
        "operationId": "recordReceiptUndocumented",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/recordReceiptUndocumentedRequest"
              },
              "examples": {
                "withReason": {
                  "$ref": "./receipt/record-receipt-undocumented-request.examples.json#/withReason"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Receipt recorded against a server-created empty Delivery. Body carries the new Delivery ID and any validation warnings.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/recordReceiptUndocumentedResponse"
                },
                "examples": {
                  "withReason": {
                    "$ref": "./receipt/record-receipt-undocumented-response.examples.json#/withReason"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/deliveries/{deliveryId}/receipt": {
      "parameters": [
        {
          "$ref": "#/components/parameters/deliveryIdPath"
        }
      ],
      "post": {
        "tags": ["Receipt"],
        "summary": "Record receipt of waste against a Delivery",
        "description": "Records receipt of the waste delivered under the given Delivery.",
        "operationId": "recordReceipt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/recordReceiptRequest"
              },
              "examples": {
                "withBrokerAndReferences": {
                  "$ref": "./receipt/record-receipt-request.examples.json#/withBrokerAndReferences"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Receipt recorded against the Delivery. Body carries the Delivery ID and any validation warnings.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/recordReceiptResponse"
                },
                "examples": {
                  "withBrokerAndReferences": {
                    "$ref": "./receipt/record-receipt-response.examples.json#/withBrokerAndReferences"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "description": "Delivery not found.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problemDetails"
                },
                "example": {
                  "type": "https://defra.github.io/digital-waste-tracking-api-site/preview/problems/not-found",
                  "title": "Not Found",
                  "detail": "No delivery exists with delivery ID: 25KMT4Z9",
                  "instance": "/deliveries/25KMT4Z9/receipt",
                  "requestId": "4c6f9e1a-8f2b-4e3d-9a1c-2b7d5e6f0a3c"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    }
  }
}
