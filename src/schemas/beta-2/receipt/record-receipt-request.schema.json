{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Record receipt request",
  "description": "Payload for POST /beta-2/deliveries/{deliveryId}/receipt.",
  "examples": [
    {
      "apiCode": "25b14080-5e77-4f91-9957-2482a0cb8775",
      "brokerOrDealer": {
        "isPresent": true,
        "items": [
          {
            "organisationName": "Broker Demo Ltd",
            "registrationNumber": "CBDU654321",
            "contactDetails": {
              "emailAddress": "broker@example.com",
              "phoneNumber": "01112223333"
            },
            "address": {
              "fullAddress": "2 Broker Yard, Test City",
              "postcode": "TE1 1ST"
            }
          }
        ]
      },
      "supportingReferences": [
        {
          "label": "Weighbridge Number",
          "reference": "WB-0042"
        }
      ]
    }
  ],
  "type": "object",
  "properties": {
    "apiCode": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier of the submitting organisation.",
      "examples": ["25b14080-5e77-4f91-9957-2482a0cb8775"]
    },
    "brokerOrDealer": {
      "$ref": "../common/broker-or-dealer/broker-or-dealer.schema.json"
    },
    "supportingReferences": {
      "$ref": "../common/supporting-references.schema.json"
    }
  },
  "required": ["apiCode"],
  "additionalProperties": false
}
