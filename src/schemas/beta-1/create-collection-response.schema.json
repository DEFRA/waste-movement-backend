{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Create collection response",
  "description": "Response returned when a collection event is recorded.",
  "type": "object",
  "required": ["data", "validation"],
  "properties": {
    "data": {
      "type": ["object", "null"],
      "description": "No resource id is returned for a collection event; always null.",
      "examples": [null]
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "$defs": {
    "issue": {
      "title": "Issue",
      "description": "A single problem with a submitted field, located by JSON Pointer.",
      "type": "object",
      "required": ["pointer", "errorType", "message"],
      "properties": {
        "pointer": {
          "type": "string",
          "description": "RFC 6901 JSON Pointer to the field this issue relates to.",
          "examples": ["/apiCode"]
        },
        "errorType": {
          "type": "string",
          "enum": [
            "NotProvided",
            "NotAllowed",
            "InvalidType",
            "InvalidFormat",
            "InvalidValue",
            "OutOfRange",
            "BusinessRuleViolation",
            "UnexpectedError"
          ],
          "description": "The type of issue.",
          "examples": ["NotProvided"]
        },
        "message": {
          "type": "string",
          "description": "Human-readable description of the issue.",
          "examples": ["apiCode is required."]
        }
      }
    },
    "validation": {
      "title": "Validation",
      "description": "Data-quality feedback returned alongside a successful response.",
      "type": "object",
      "required": ["warnings"],
      "properties": {
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "description": "Data-quality warnings. Empty when there are none."
        }
      }
    }
  }
}
